{
  "name": "remote-hosts-compare-sync",
  "displayName": "Remote Hosts Compare & Sync",
  "description": "%ext.description%",
  "version": "0.10.0",
  "publisher": "EnnoZudemEis",
  "author": {
    "name": "EnnoZudemEis",
    "url": "https://www.panda-core.net"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://www.panda-core.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/EnnoZudemEis/remote-host-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/EnnoZudemEis/remote-host-explorer/issues"
  },
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "%cap.virtual%"
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%cap.untrusted%"
    }
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ftp",
    "sftp",
    "ftps",
    "ssh",
    "remote",
    "deployment",
    "deploy",
    "sync",
    "diff",
    "compare",
    "backup",
    "upload"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "remoteHost",
          "title": "Remote Host",
          "icon": "$(remote-explorer)"
        }
      ]
    },
    "views": {
      "remoteHost": [
        {
          "id": "remoteHost.tree",
          "name": "Remote Host"
        },
        {
          "id": "remoteHost.compare",
          "name": "%view.compare.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "remoteHost.tree",
        "contents": "%welcome.tree%"
      },
      {
        "view": "remoteHost.compare",
        "contents": "%welcome.compare%"
      }
    ],
    "commands": [
      {
        "command": "remoteHost.addServer",
        "title": "%cmd.addServer.title%",
        "icon": "$(add)",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.openConfig",
        "title": "%cmd.openConfig.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.selectServer",
        "title": "%cmd.selectServer.title%",
        "icon": "$(server)",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.refresh",
        "title": "%cmd.refresh.title%",
        "icon": "$(refresh)",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.upload",
        "title": "%cmd.upload.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.download",
        "title": "%cmd.download.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.newFile",
        "title": "%cmd.newFile.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.newFolder",
        "title": "%cmd.newFolder.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.rename",
        "title": "%cmd.rename.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.delete",
        "title": "%cmd.delete.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.copyPath",
        "title": "%cmd.copyPath.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.compareFolder",
        "title": "%cmd.compareFolder.title%",
        "icon": "$(git-compare)",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.compareFile",
        "title": "%cmd.compareFile.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.diffItem",
        "title": "%cmd.diffItem.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.uploadItem",
        "title": "%cmd.uploadItem.title%",
        "icon": "$(cloud-upload)",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.downloadItem",
        "title": "%cmd.downloadItem.title%",
        "icon": "$(cloud-download)",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.clearCompare",
        "title": "%cmd.clearCompare.title%",
        "icon": "$(clear-all)",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.showLog",
        "title": "%cmd.showLog.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.forgetHostKeys",
        "title": "%cmd.forgetHostKeys.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.uploadMany",
        "title": "%cmd.uploadMany.title%",
        "icon": "$(cloud-upload)",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.downloadMany",
        "title": "%cmd.downloadMany.title%",
        "icon": "$(cloud-download)",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.deleteRemoteOnly",
        "title": "%cmd.deleteRemoteOnly.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.deleteLocalOnly",
        "title": "%cmd.deleteLocalOnly.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.compareLayout",
        "title": "%cmd.compareLayout.title%",
        "icon": "$(list-tree)",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.compareFilter",
        "title": "%cmd.compareFilter.title%",
        "icon": "$(filter)",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.compareServers",
        "title": "%cmd.compareServers.title%",
        "icon": "$(arrow-swap)",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.downloadFromA",
        "title": "%cmd.downloadFromA.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.downloadFromB",
        "title": "%cmd.downloadFromB.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.manageServers",
        "title": "%cmd.manageServers.title%",
        "icon": "$(gear)",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.editRemote",
        "title": "%cmd.editRemote.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.revealOpened",
        "title": "%cmd.revealOpened.title%",
        "icon": "$(target)",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.openSsh",
        "title": "%cmd.openSsh.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.chmod",
        "title": "%cmd.chmod.title%",
        "category": "Remote Host"
      },
      {
        "command": "remoteHost.searchRemote",
        "title": "%cmd.searchRemote.title%",
        "icon": "$(search)",
        "category": "Remote Host"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "remoteHost.deleteRemoteOnly",
          "when": "false"
        },
        {
          "command": "remoteHost.deleteLocalOnly",
          "when": "false"
        },
        {
          "command": "remoteHost.copyPath",
          "when": "false"
        },
        {
          "command": "remoteHost.delete",
          "when": "false"
        },
        {
          "command": "remoteHost.diffItem",
          "when": "false"
        },
        {
          "command": "remoteHost.download",
          "when": "false"
        },
        {
          "command": "remoteHost.downloadFromA",
          "when": "false"
        },
        {
          "command": "remoteHost.downloadFromB",
          "when": "false"
        },
        {
          "command": "remoteHost.downloadItem",
          "when": "false"
        },
        {
          "command": "remoteHost.editRemote",
          "when": "false"
        },
        {
          "command": "remoteHost.newFile",
          "when": "false"
        },
        {
          "command": "remoteHost.newFolder",
          "when": "false"
        },
        {
          "command": "remoteHost.rename",
          "when": "false"
        },
        {
          "command": "remoteHost.uploadItem",
          "when": "false"
        },
        {
          "command": "remoteHost.chmod",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "remoteHost.selectServer",
          "when": "view == remoteHost.tree",
          "group": "navigation@1"
        },
        {
          "command": "remoteHost.addServer",
          "when": "view == remoteHost.tree",
          "group": "navigation@2"
        },
        {
          "command": "remoteHost.refresh",
          "when": "view == remoteHost.tree",
          "group": "navigation@3"
        },
        {
          "command": "remoteHost.compareFolder",
          "when": "view == remoteHost.tree",
          "group": "navigation@4"
        },
        {
          "command": "remoteHost.compareFolder",
          "when": "view == remoteHost.compare",
          "group": "navigation@1"
        },
        {
          "command": "remoteHost.clearCompare",
          "when": "view == remoteHost.compare",
          "group": "navigation@2"
        },
        {
          "command": "remoteHost.uploadMany",
          "when": "view == remoteHost.compare",
          "group": "navigation@6"
        },
        {
          "command": "remoteHost.downloadMany",
          "when": "view == remoteHost.compare",
          "group": "navigation@7"
        },
        {
          "command": "remoteHost.compareLayout",
          "when": "view == remoteHost.compare",
          "group": "navigation@4"
        },
        {
          "command": "remoteHost.compareFilter",
          "when": "view == remoteHost.compare",
          "group": "navigation@5"
        },
        {
          "command": "remoteHost.compareServers",
          "when": "view == remoteHost.tree",
          "group": "navigation@5"
        },
        {
          "command": "remoteHost.compareServers",
          "when": "view == remoteHost.compare",
          "group": "navigation@3"
        },
        {
          "command": "remoteHost.manageServers",
          "when": "view == remoteHost.tree",
          "group": "navigation@6"
        },
        {
          "command": "remoteHost.revealOpened",
          "when": "view == remoteHost.tree",
          "group": "navigation@7"
        },
        {
          "command": "remoteHost.searchRemote",
          "when": "view == remoteHost.tree",
          "group": "navigation@7"
        }
      ],
      "view/item/context": [
        {
          "command": "remoteHost.upload",
          "when": "view == remoteHost.tree",
          "group": "1_transfer@1"
        },
        {
          "command": "remoteHost.download",
          "when": "view == remoteHost.tree",
          "group": "1_transfer@2"
        },
        {
          "command": "remoteHost.newFile",
          "when": "view == remoteHost.tree && viewItem == dir",
          "group": "2_edit@1"
        },
        {
          "command": "remoteHost.newFolder",
          "when": "view == remoteHost.tree && viewItem == dir",
          "group": "2_edit@2"
        },
        {
          "command": "remoteHost.rename",
          "when": "view == remoteHost.tree",
          "group": "2_edit@3"
        },
        {
          "command": "remoteHost.delete",
          "when": "view == remoteHost.tree",
          "group": "2_edit@4"
        },
        {
          "command": "remoteHost.copyPath",
          "when": "view == remoteHost.tree",
          "group": "3_misc@1"
        },
        {
          "command": "remoteHost.compareFolder",
          "when": "view == remoteHost.tree && viewItem == dir",
          "group": "1_transfer@3"
        },
        {
          "command": "remoteHost.compareFile",
          "when": "view == remoteHost.tree && viewItem == file",
          "group": "1_transfer@3"
        },
        {
          "command": "remoteHost.uploadMany",
          "when": "view == remoteHost.compare && viewItem =~ /^compare(Folder|Group)$/",
          "group": "inline@1"
        },
        {
          "command": "remoteHost.downloadMany",
          "when": "view == remoteHost.compare && viewItem =~ /^compare(Folder|Group)$/",
          "group": "inline@2"
        },
        {
          "command": "remoteHost.uploadMany",
          "when": "view == remoteHost.compare && viewItem =~ /^compare(Folder|Group)$/",
          "group": "1_sync@1"
        },
        {
          "command": "remoteHost.downloadMany",
          "when": "view == remoteHost.compare && viewItem =~ /^compare(Folder|Group)$/",
          "group": "1_sync@2"
        },
        {
          "command": "remoteHost.deleteRemoteOnly",
          "when": "view == remoteHost.compare && viewItem =~ /^(compare(Folder|Group)|compare-remoteOnly)$/",
          "group": "2_delete@1"
        },
        {
          "command": "remoteHost.deleteLocalOnly",
          "when": "view == remoteHost.compare && viewItem =~ /^(compare(Folder|Group)|compare-localOnly)$/",
          "group": "2_delete@2"
        },
        {
          "command": "remoteHost.uploadItem",
          "when": "view == remoteHost.compare && viewItem =~ /^compare-(modified|localOnly)$/",
          "group": "inline@1"
        },
        {
          "command": "remoteHost.downloadItem",
          "when": "view == remoteHost.compare && viewItem =~ /^compare-(modified|remoteOnly)$/",
          "group": "inline@2"
        },
        {
          "command": "remoteHost.uploadItem",
          "when": "view == remoteHost.compare && viewItem =~ /^compare-(modified|localOnly)$/",
          "group": "1_sync@1"
        },
        {
          "command": "remoteHost.downloadItem",
          "when": "view == remoteHost.compare && viewItem =~ /^compare-(modified|remoteOnly)$/",
          "group": "1_sync@2"
        },
        {
          "command": "remoteHost.compareServers",
          "when": "view == remoteHost.tree && viewItem == dir",
          "group": "1_transfer@4"
        },
        {
          "command": "remoteHost.downloadFromA",
          "when": "view == remoteHost.compare && viewItem =~ /^compareRR-(modified|localOnly)$/",
          "group": "1_sync@1"
        },
        {
          "command": "remoteHost.downloadFromB",
          "when": "view == remoteHost.compare && viewItem =~ /^compareRR-(modified|remoteOnly)$/",
          "group": "1_sync@2"
        },
        {
          "command": "remoteHost.editRemote",
          "when": "view == remoteHost.tree && viewItem == file",
          "group": "0_open@1"
        },
        {
          "command": "remoteHost.openSsh",
          "when": "view == remoteHost.tree && remoteHost.isSftp",
          "group": "3_misc@2"
        },
        {
          "command": "remoteHost.chmod",
          "when": "view == remoteHost.tree",
          "group": "3_misc@3"
        },
        {
          "command": "remoteHost.searchRemote",
          "when": "view == remoteHost.tree && viewItem == dir",
          "group": "3_misc@4"
        }
      ],
      "explorer/context": [
        {
          "command": "remoteHost.upload",
          "group": "remoteHost@1"
        },
        {
          "command": "remoteHost.compareFile",
          "when": "!explorerResourceIsFolder",
          "group": "remoteHost@2"
        },
        {
          "command": "remoteHost.revealOpened",
          "when": "!explorerResourceIsFolder",
          "group": "remoteHost@3"
        },
        {
          "command": "remoteHost.compareFolder",
          "when": "explorerResourceIsFolder",
          "group": "remoteHost@4"
        }
      ],
      "editor/title/context": [
        {
          "command": "remoteHost.revealOpened",
          "group": "remoteHost"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": ".vscode/remote-hosts.json",
        "url": "./schemas/remote-hosts.schema.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "npx --yes @vscode/vsce package",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/extension.js --external:vscode --external:cpu-features --external:*.node --minify",
    "vscode:prepublish": "npm run bundle"
  },
  "dependencies": {
    "basic-ftp": "^6.2.6",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ssh2": "^1.15.6",
    "@types/ssh2-sftp-client": "^9.0.4",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0"
  },
  "l10n": "./l10n"
}
